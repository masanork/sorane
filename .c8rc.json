{
  "include": ["packages/**/*.ts"],
  "exclude": [
    "packages/**/wasm/**",
    "packages/search/**",
    "packages/cli/src/watch.ts"
  ],
  "exclude-after-remap": true,
  "check-coverage": true,
  "lines": 90,
  "branches": 65,
  "functions": 60,
  "reporter": ["text-summary", "lcov", "json-summary"],
  "reports-dir": "coverage"
}
