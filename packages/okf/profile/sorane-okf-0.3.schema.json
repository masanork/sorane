{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ssg.sorane.dev/profile/sorane-okf/0.3",
  "title": "sorane-okf/0.3",
  "description": "sorane profile on OKF v0.2 base: extended types, open-data metadata, AI disclosure, and optional OKF trust/provenance/lifecycle fields.",
  "oneOf": [
    { "$ref": "#/$defs/article" },
    { "$ref": "#/$defs/index" },
    { "$ref": "#/$defs/dataset" },
    { "$ref": "#/$defs/reference" },
    { "$ref": "#/$defs/glossary" },
    { "$ref": "#/$defs/glossary-term" },
    { "$ref": "#/$defs/faq" }
  ],
  "$defs": {
    "actorEvent": {
      "type": "object",
      "required": ["by", "at"],
      "properties": {
        "by": { "type": "string", "minLength": 1, "description": "Actor: producer/version | human:<id> | process:<id>" },
        "at": { "type": "string", "format": "date-time", "description": "ISO 8601 datetime with explicit UTC offset" }
      },
      "additionalProperties": true
    },
    "dateRange": {
      "type": "object",
      "properties": {
        "from": { "type": "string", "format": "date-time" },
        "to": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "sourceEntry": {
      "type": "object",
      "required": ["resource"],
      "properties": {
        "resource": { "type": "string", "minLength": 1 },
        "id": { "type": "string" },
        "title": { "type": "string" },
        "author": { "type": "string" },
        "usage_count": { "type": "number" },
        "last_modified": { "type": "string", "format": "date-time" },
        "usage_window": { "$ref": "#/$defs/dateRange" }
      },
      "additionalProperties": true
    },
    "publisher": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "distribution": {
      "type": "object",
      "required": ["title", "format", "accessURL"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "minLength": 1 },
        "accessURL": { "type": "string", "minLength": 1 },
        "downloadURL": { "type": "string", "minLength": 1 },
        "byteSize": { "type": "integer", "minimum": 0 },
        "checksum": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "temporal": {
      "type": "object",
      "properties": {
        "start": { "type": "string", "minLength": 1 },
        "end": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "okfBase": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "resource": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Content-change timestamp; takes precedence over generated.at when both are present"
        },
        "profile": { "type": "string" },
        "generated": { "$ref": "#/$defs/actorEvent" },
        "verified": {
          "oneOf": [
            { "$ref": "#/$defs/actorEvent" },
            {
              "type": "array",
              "items": { "$ref": "#/$defs/actorEvent" }
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceEntry" }
        },
        "usage_window": { "$ref": "#/$defs/dateRange" },
        "status": {
          "type": "string",
          "enum": ["draft", "stable", "deprecated"]
        },
        "stale_after": {
          "type": "string",
          "format": "date-time",
          "description": "Absolute instant with explicit UTC offset; stale when now >= stale_after"
        },
        "identifier": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 2 },
        "license": { "type": "string", "minLength": 1 },
        "publisher": { "$ref": "#/$defs/publisher" },
        "theme": { "type": "string", "minLength": 1 },
        "temporal": { "$ref": "#/$defs/temporal" },
        "spatial": { "type": "string", "minLength": 1 },
        "distributions": {
          "type": "array",
          "items": { "$ref": "#/$defs/distribution" }
        },
        "creativeWorkType": {
          "type": "string",
          "enum": ["BlogPosting", "TechArticle"]
        },
        "digitalSourceType": {
          "type": "string",
          "minLength": 1
        },
        "euAiLabel": {
          "type": "string",
          "enum": ["basic", "fully-generated", "partially-modified"]
        },
        "aiDisclosureNote": { "type": "string", "maxLength": 500 },
        "aiSystems": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string" },
              "provider": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "article": {
      "allOf": [
        { "$ref": "#/$defs/okfBase" },
        {
          "properties": { "type": { "const": "article" } },
          "required": ["type", "title"]
        }
      ]
    },
    "index": {
      "allOf": [
        { "$ref": "#/$defs/okfBase" },
        {
          "properties": { "type": { "const": "index" } },
          "required": ["type", "title"]
        }
      ]
    },
    "dataset": {
      "allOf": [
        { "$ref": "#/$defs/okfBase" },
        {
          "properties": {
            "type": { "const": "dataset" },
            "distributions": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/distribution" }
            }
          },
          "required": [
            "type",
            "title",
            "description",
            "resource",
            "license",
            "publisher",
            "distributions"
          ]
        }
      ]
    },
    "reference": {
      "allOf": [
        { "$ref": "#/$defs/okfBase" },
        {
          "properties": { "type": { "const": "reference" } },
          "required": ["type", "title"]
        }
      ]
    },
    "glossary": {
      "allOf": [
        { "$ref": "#/$defs/okfBase" },
        {
          "properties": { "type": { "const": "glossary" } },
          "required": ["type", "title"]
        }
      ]
    },
    "glossary-term": {
      "allOf": [
        { "$ref": "#/$defs/okfBase" },
        {
          "properties": {
            "type": { "const": "glossary-term" },
            "term_id": { "type": "string", "minLength": 1 },
            "inDefinedTermSet": { "type": "string", "minLength": 1 },
            "glossary": { "type": "string", "minLength": 1 },
            "seeAlso": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "required": ["type", "title"]
        }
      ]
    },
    "faq": {
      "allOf": [
        { "$ref": "#/$defs/okfBase" },
        {
          "properties": { "type": { "const": "faq" } },
          "required": ["type", "title"]
        }
      ]
    }
  }
}
