{
  "$schema":"../../node_modules/wrangler/config-schema.json",
  "name":"sorane-public", "main":"src/worker.ts", "compatibility_date":"2026-10-08",
  "compatibility_flags":["nodejs_compat","disallow_importable_env"],"workers_dev":false,"preview_urls":false,
  "vars":{"PUBLIC_ORIGIN":"https://replace-public-origin.example"},
  "d1_databases":[{"binding":"DB","database_name":"sorane-admin","database_id":"00000000-0000-0000-0000-000000000000","remote":false}],
  "r2_buckets":[{"binding":"BUILDS","bucket_name":"sorane-builds-dev","remote":false}],
  "observability":{"enabled":true,"logs":{"enabled":true,"invocation_logs":false},"traces":{"enabled":false}}
}
