{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sorane-admin",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ADMIN_MODE": "full",
    "ISSUER": "https://auth.mikaki.org",
    "RP_ORIGIN": "http://localhost:8787",
    "CLIENT_ID": "register-this-rp-with-mikaki",
    "PUBLIC_ORIGIN": "https://replace-public-origin.example",
    "EXPECTED_ENGINE": "bundle-the-ssg-worker-first"
  },
  "secrets": { "required": ["RP_PRIVATE_JWK"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "sorane-admin",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations",
    "remote": false
  }],
  "queues": { "producers": [{ "binding": "BUILD_QUEUE", "queue": "sorane-build-jobs-dev" }] },
  "services": [{ "binding": "CONTENT_SOURCE", "service": "sorane-build", "entrypoint": "ContentSource" }],
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
